# Vapi (voice AI orchestration) — Dashboard > API Keys
VAPI_PRIVATE_KEY=

# Supabase (call logs, bookings, client config) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (booking) — OAuth Client (APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app / Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtained by running: npm run setup:google-token (one-time browser auth as the calendar owner)
GOOGLE_OAUTH_REFRESH_TOKEN=
# Calendar ID to book into — "primary" is correct since we authenticate directly as the owner
GOOGLE_CALENDAR_ID=primary

# Local server
PORT=3000
# Public URL Vapi can reach this server at (use ngrok/cloudflared in dev)
PUBLIC_SERVER_URL=

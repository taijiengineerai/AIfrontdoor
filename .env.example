# Vapi (voice AI orchestration) — Dashboard > API Keys
VAPI_PRIVATE_KEY=

# Supabase (call logs, bookings, client config) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (booking) — path to the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# Calendar ID to book into (the pilot client's calendar, shared with the service account email)
GOOGLE_CALENDAR_ID=primary

# Local server
PORT=3000
# Public URL Vapi can reach this server at (use ngrok/cloudflared in dev)
PUBLIC_SERVER_URL=
